# Supabase client configuration
# VITE_* values are embedded into the browser bundle by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PROJECT_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets
# Never expose these through VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ELEVENLABS_API_KEY=

# Server-only backend configuration
VIDEO_GENERATION_BACKEND_URL=

# External TRIBE v2 FastAPI GPU service.
# Prefer server-side TRIBE_API_URL if proxying through TanStack server functions.
TRIBE_API_URL=
# Only set this when browser-side direct calls or viewer embedding need the base URL.
VITE_TRIBE_API=
